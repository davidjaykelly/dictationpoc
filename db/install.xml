<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="question/type/dictationpoc/db" VERSION="2025043000" COMMENT="Install structure for Dictation PoC question type" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="qtype_dictationpoc_options" COMMENT="Extra data for dictation questions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" SEQUENCE="false" NOTNULL="true"/>
        <FIELD NAME="audiourl" TYPE="char" LENGTH="255" SEQUENCE="false" NOTNULL="false"/>
        <FIELD NAME="sentence" TYPE="text" SEQUENCE="false" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionid_fk" TYPE="foreign" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
